[Unit]
Description=HADeck - StreamDeck+ Client for Home Assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hadeck
Group=hadeck
WorkingDirectory=/opt/hadeck
ExecStart=/opt/hadeck/runservice.sh
EnvironmentFile=/opt/hadeck/.env
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
