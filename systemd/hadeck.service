[Unit]
Description=HADeck - StreamDeck+ Client for Home Assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hadeck
ExecStart=/opt/hadeck/.venv/bin/python main.py
EnvironmentFile=/opt/hadeck/.env
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
